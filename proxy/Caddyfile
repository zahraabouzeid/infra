(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}

transit.{$MCP_DOMAIN} {
	import common
	reverse_proxy transit-mcp:8000
}

canteen.{$MCP_DOMAIN} {
	import common
	reverse_proxy canteen-mcp:8000
}

ical.{$MCP_DOMAIN} {
	import common
	reverse_proxy ical-mcp:8000
}

webdav.{$MCP_DOMAIN} {
	import common
	reverse_proxy webdav-mcp:8000
}

moodle.{$MCP_DOMAIN} {
	import common
	reverse_proxy moodle-mcp:8000
}

memory.{$MCP_DOMAIN} {
	import common
	reverse_proxy memory-mcp:8000
}
